# Use the PostgreSQL credentials configured on your machine.
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/job_tracker?schema=public"

# Replace this placeholder with a private random value of at least 32 characters.
JWT_SECRET="replace-with-a-private-random-secret-at-least-32-characters"

NODE_ENV="development"
PORT=3000
FRONTEND_ORIGIN="http://localhost:5173"
DEFAULT_FOLLOW_UP_DAYS=7
# Mondays at 09:00 UTC. The expression follows standard five-field cron syntax.
DIGEST_CRON="0 9 * * 1"

# Local Docker Compose routes mail to Mailpit. For a local API outside Docker,
# use localhost; production can use SMTP settings from Resend or another provider.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Job Tracker <digest@example.com>"

# Docker Compose settings. Use a URL-safe password for the container database.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-private-url-safe-password
POSTGRES_DB=job_tracker
POSTGRES_HOST_PORT=5433
API_HOST_PORT=3000
